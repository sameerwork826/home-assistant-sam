# ==============================================================================
# Alexa-to-Windows Command Execution System - Environment Configuration
# Copy this file to .env and customize values for your deployment.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Command Broker Configuration
# ------------------------------------------------------------------------------
# Host and port for the FastAPI cloud broker service
BROKER_HOST=0.0.0.0
BROKER_PORT=8000

# Security secret shared between Cloud Broker and Windows Agent.
# Generate a strong 32-character random token (e.g. using: openssl rand -hex 32)
AGENT_AUTH_TOKEN=change-this-to-a-very-strong-random-token-min-32-chars

# Alexa Skill Application ID (e.g. amzn1.ask.skill.12345678-abcd-1234-abcd-1234567890ab)
# Found in the Alexa Developer Console under Skill -> Skill Settings -> Skill ID
ALEXA_SKILL_ID=amzn1.ask.skill.YOUR_SKILL_ID_HERE

# Whether to enforce full Alexa cryptographic signature verification (cert chain & RSA)
# Set to 'true' in production (mandatory by Amazon for public HTTPS endpoints).
# Set to 'false' only during local offline development or mock unit tests.
ALEXA_VERIFY_SIGNATURE=true

# Database URL for persistent command queue and audit logs (default: SQLite)
DATABASE_URL=sqlite:///./command_broker.db

# Command expiration in seconds (stale commands older than this are dropped)
COMMAND_TTL_SECONDS=30

# Maximum number of commands allowed in the pending queue
MAX_QUEUE_SIZE=50

# Maximum requests per minute per IP / client (DDoS & brute force defense)
RATE_LIMIT_PER_MINUTE=120

# Optional admin dashboard username & password (basic auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-secure-password

# ------------------------------------------------------------------------------
# 2. Windows Agent Configuration
# ------------------------------------------------------------------------------
# URL of the Cloud Broker (e.g., https://your-broker-domain.com or http://localhost:8000 for local test)
BROKER_API_URL=http://localhost:8000

# WebSocket URL of the Cloud Broker for real-time outbound connection
# (e.g., wss://your-broker-domain.com/ws/agent or ws://localhost:8000/ws/agent)
BROKER_WS_URL=ws://localhost:8000/ws/agent

# Polling interval in seconds if falling back to HTTP polling
AGENT_POLL_INTERVAL_SECONDS=2.0

# WebSocket heartbeat / ping interval in seconds
AGENT_HEARTBEAT_INTERVAL_SECONDS=25.0

# Unique identifier for this Windows machine
AGENT_ID=windows-laptop-primary

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path where agent execution logs are stored
LOG_FILE_PATH=./logs/windows_agent.log

# ------------------------------------------------------------------------------
# 3. Application Executable Paths & Approved Websites (Windows Agent)
# ------------------------------------------------------------------------------
# Path to Google Chrome executable. Leave empty to auto-discover in standard locations.
CHROME_PATH=

# Path to Visual Studio Code executable. Leave empty to auto-discover in standard locations.
VSCODE_PATH=

# Approved URLs for the OpenWebsite command (comma-separated key=url pairs)
# Only domains listed here will be accepted. Arbitrary URLs will be strictly rejected.
APPROVED_WEBSITES=google=https://www.google.com,youtube=https://www.youtube.com,github=https://www.github.com,reddit=https://www.reddit.com,chatgpt=https://chatgpt.com

# Default delay in seconds for Windows shutdown/restart (gives time to cancel)
SHUTDOWN_DELAY_SECONDS=60
